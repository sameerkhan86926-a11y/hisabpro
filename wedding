<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wedding Invitation | Sameer & Priya</title>
    <!-- Google Fonts for Royal Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #7a1526; /* Royal Burgundy */
            --primary-dark: #4d0a15;
            --gold: #d4af37; /* Metallic Gold */
            --gold-light: #f7e7ce;
            --bg-creme: #fdfaf6;
            --text-dark: #2c2523;
            --text-muted: #6c5a54;
            --card-shadow: 0 15px 35px rgba(122, 21, 38, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-creme);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
            background-image: radial-gradient(#d4af37 0.6px, transparent 0.6px);
            background-size: 24px 24px;
        }

        /* Royal Header Section */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 2rem 1rem;
            position: relative;
            background: linear-gradient(180deg, rgba(253, 250, 246, 0.94) 0%, rgba(253, 250, 246, 0.85) 100%);
            border-bottom: 3px double var(--gold);
        }

        .ganesh-icon {
            font-size: 2.8rem;
            color: var(--gold);
            margin-bottom: 0.5rem;
            filter: drop-shadow(0 2px 4px rgba(212, 175, 55, 0.3));
        }

        .shlok {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            color: var(--primary);
            letter-spacing: 1px;
            margin-bottom: 1.5rem;
        }

        .invitation-badge {
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 0.85rem;
            color: var(--gold);
            border-top: 1px solid var(--gold);
            border-bottom: 1px solid var(--gold);
            padding: 6px 18px;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        .couple-names {
            font-family: 'Great Vibes', cursive;
            font-size: 4.8rem;
            color: var(--primary);
            margin: 0;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.05);
            line-height: 1.2;
        }

        .couple-names span {
            font-family: 'Cinzel Decorative', cursive;
            font-size: 2.5rem;
            color: var(--gold);
            display: block;
            margin: 0.3rem 0;
        }

        .wedding-date-hero {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            color: var(--text-dark);
            margin-top: 1.5rem;
            letter-spacing: 2px;
            font-weight: 600;
        }

        .venue-brief {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-top: 0.5rem;
            letter-spacing: 1px;
        }

        /* Countdown Timer */
        .countdown-container {
            display: flex;
            gap: 1.5rem;
            margin-top: 2.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .countdown-box {
            background: white;
            border: 1px solid var(--gold);
            border-radius: 8px;
            padding: 12px 18px;
            min-width: 75px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.04);
            text-align: center;
        }

        .countdown-box span {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: block;
            line-height: 1;
        }

        .countdown-box label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 1px;
            font-weight: 600;
        }

        /* Section Styling */
        section {
            padding: 5rem 1.5rem;
            max-width: 1050px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 3.5rem;
            position: relative;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            color: var(--primary);
            text-transform: capitalize;
            letter-spacing: 1px;
        }

        .section-header::after {
            content: '❖';
            color: var(--gold);
            display: block;
            margin-top: 6px;
            font-size: 1.1rem;
        }

        /* Couple Section */
        .couple-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
        }

        .profile-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid rgba(212, 175, 55, 0.4);
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: var(--card-shadow);
            position: relative;
        }

        .profile-card::before {
            content: '';
            position: absolute;
            top: 8px;
            left: 8px;
            right: 8px;
            bottom: 8px;
            border: 1px dashed var(--gold-light);
            border-radius: 8px;
            pointer-events: none;
        }

        .profile-img-wrap {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            margin: 0 auto 1.5rem;
            padding: 4px;
            background: linear-gradient(135deg, var(--gold), var(--primary));
        }

        .profile-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background-color: #f7f3ec;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: var(--primary);
            border: 3px solid white;
        }

        .profile-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            color: var(--primary);
            margin-bottom: 0.4rem;
        }

        .profile-details {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        /* Events Timeline */
        .timeline {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.8rem;
        }

        .event-card {
            background: white;
            border-radius: 12px;
            border-top: 4px solid var(--primary);
            border-left: 1px solid #ede3d8;
            border-right: 1px solid #ede3d8;
            border-bottom: 1px solid #ede3d8;
            padding: 2rem 1.5rem;
            box-shadow: var(--card-shadow);
            text-align: center;
            transition: all 0.3s ease;
        }

        .event-card:hover {
            transform: translateY(-5px);
            border-top-color: var(--gold);
        }

        .event-icon {
            width: 60px;
            height: 60px;
            background: #fdf5f5;
            color: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.5rem;
            border: 1px solid var(--gold-light);
        }

        .event-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .event-date-time {
            font-size: 0.9rem;
            color: var(--gold);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.8rem;
        }

        .event-loc {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* Venue Section */
        .venue-section {
            background: white;
            border-radius: 16px;
            border: 1px solid var(--gold-light);
            padding: 3rem 2rem;
            box-shadow: var(--card-shadow);
            text-align: center;
        }

        .venue-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .venue-address {
            color: var(--text-muted);
            max-width: 500px;
            margin: 0 auto 1.5rem;
            font-size: 1rem;
        }

        .btn-gold {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, var(--gold), #b89123);
            color: white;
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
            border: none;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-gold:hover {
            transform: scale(1.03);
            background: linear-gradient(135deg, #b89123, var(--gold));
        }

        /* RSVP & Host Section */
        .host-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .host-card {
            background: white;
            padding: 1.8rem;
            border-radius: 10px;
            border: 1px solid #ebd9c5;
            text-align: center;
        }

        .host-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .contact-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* RSVP Form */
        .rsvp-form {
            background: #fff;
            padding: 2.5rem;
            border-radius: 12px;
            border: 1px solid var(--gold-light);
            max-width: 600px;
            margin: 0 auto;
            box-shadow: var(--card-shadow);
        }

        .form-group {
            margin-bottom: 1.2rem;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.3rem;
            text-transform: uppercase;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            border-radius: 6px;
            border: 1px solid #dcd4c8;
            font-family: inherit;
            outline: none;
            background: #fdfdfd;
        }

        .form-group input:focus, .form-group select:focus {
            border-color: var(--gold);
        }

        /* Footer */
        footer {
            background: var(--primary-dark);
            color: #fff;
            text-align: center;
            padding: 3rem 1rem;
            border-top: 3px double var(--gold);
        }

        .footer-note {
            font-family: 'Great Vibes', cursive;
            font-size: 2.4rem;
            color: var(--gold);
            margin-bottom: 0.5rem;
        }

        /* Floating Audio Button */
        .music-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--primary);
            color: var(--gold);
            border: 2px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.25);
            z-index: 100;
            font-size: 1.1rem;
        }

        @media (max-width: 768px) {
            .couple-names { font-size: 3.5rem; }
            .couple-grid { grid-template-columns: 1fr; }
            section { padding: 3.5rem 1rem; }
            .countdown-container { gap: 0.8rem; }
            .countdown-box { min-width: 60px; padding: 10px; }
            .countdown-box span { font-size: 1.4rem; }
        }
    </style>
</head>
<body>

    <!-- Floating Shehnai Music Control -->
    <button class="music-btn" id="musicToggle" title="Play/Pause Music">
        <i class="fa-solid fa-music"></i>
    </button>
    <audio id="weddingAudio" loop>
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=indian-flute-112347.mp3" type="audio/mp3">
    </audio>

    <!-- Hero / Main Invitation Header -->
    <header class="hero">
        <div class="ganesh-icon">卐 || श्री गणेशाय नमः || 卐</div>
        <p class="shlok">वक्रतुण्ड महाकाय सूर्यकोटि समप्रभ। निर्विघ्नं कुरु मे देव सर्वकार्येषु सर्वदा॥</p>
        
        <div class="invitation-badge">Wedding Invitation</div>
        
        <h1 class="couple-names">
            Sameer
            <span>&</span>
            Priya
        </h1>

        <div class="wedding-date-hero">
            DECEMBER 14, 2026
        </div>
        <p class="venue-brief">The Grand Palace Banquets, New Delhi</p>

        <!-- Live Countdown -->
        <div class="countdown-container" id="countdown">
            <div class="countdown-box">
                <span id="days">00</span>
                <label>Days</label>
            </div>
            <div class="countdown-box">
                <span id="hours">00</span>
                <label>Hours</label>
            </div>
            <div class="countdown-box">
                <span id="minutes">00</span>
                <label>Mins</label>
            </div>
            <div class="countdown-box">
                <span id="seconds">00</span>
                <label>Secs</label>
            </div>
        </div>
    </header>

    <!-- Groom & Bride Details -->
    <section>
        <div class="section-header">
            <h2 class="section-title">Together With Their Families</h2>
        </div>

        <div class="couple-grid">
            <!-- Groom Card -->
            <div class="profile-card">
                <div class="profile-img-wrap">
                    <div class="profile-img"><i class="fa-solid fa-user-tie"></i></div>
                </div>
                <h3 class="profile-name">Sameer</h3>
                <p class="profile-details">
                    Son of Smt. Sunita Devi & Shri Ramesh Kumar<br>
                    Grandson of Late Shri Ram Lal
                </p>
                <p style="font-size: 0.9rem; color: #555; font-style: italic;">
                    "Two souls, one heart, beginning a journey of a lifetime."
                </p>
            </div>

            <!-- Bride Card -->
            <div class="profile-card">
                <div class="profile-img-wrap">
                    <div class="profile-img"><i class="fa-solid fa-ring"></i></div>
                </div>
                <h3 class="profile-name">Priya</h3>
                <p class="profile-details">
                    Daughter of Smt. Anita Sharma & Shri Suresh Sharma<br>
                    Granddaughter of Late Shri B. L. Sharma
                </p>
                <p style="font-size: 0.9rem; color: #555; font-style: italic;">
                    "Finding love and starting our happily ever after."
                </p>
            </div>
        </div>
    </section>

    <!-- Wedding Itinerary / Functions -->
    <section>
        <div class="section-header">
            <h2 class="section-title">Wedding Ceremonies</h2>
        </div>

        <div class="timeline">
            <!-- Event 1 -->
            <div class="event-card">
                <div class="event-icon"><i class="fa-solid fa-sun"></i></div>
                <h3 class="event-title">Haldi & Mehendi</h3>
                <div class="event-date-time">Dec 12, 2026 | 02:00 PM</div>
                <p class="event-loc">At Residence: Karol Bagh, New Delhi</p>
            </div>

            <!-- Event 2 -->
            <div class="event-card">
                <div class="event-icon"><i class="fa-solid fa-champagne-glasses"></i></div>
                <h3 class="event-title">Sangeet & Cocktail</h3>
                <div class="event-date-time">Dec 13, 2026 | 07:00 PM</div>
                <p class="event-loc">Imperial Lawn, Pusa Road, Delhi</p>
            </div>

            <!-- Event 3 -->
            <div class="event-card">
                <div class="event-icon"><i class="fa-solid fa-fire"></i></div>
                <h3 class="event-title">Shubh Vivah (Wedding)</h3>
                <div class="event-date-time">Dec 14, 2026 | 07:30 PM</div>
                <p class="event-loc">The Grand Palace Banquets, Main Ring Road, Delhi</p>
            </div>

            <!-- Event 4 -->
            <div class="event-card">
                <div class="event-icon"><i class="fa-solid fa-crown"></i></div>
                <h3 class="event-title">Reception Dinner</h3>
                <div class="event-date-time">Dec 15, 2026 | 08:00 PM</div>
                <p class="event-loc">The Grand Palace Banquets, Main Ring Road, Delhi</p>
            </div>
        </div>
    </section>

    <!-- Venue & Location Details -->
    <section>
        <div class="section-header">
            <h2 class="section-title">Venue & Location</h2>
        </div>

        <div class="venue-section">
            <h3 class="venue-name"><i class="fa-solid fa-location-dot" style="color: var(--gold); margin-right: 8px;"></i> The Grand Palace Banquets</h3>
            <p class="venue-address">
                Gate No. 2, Near Metro Station, Ring Road, New Delhi, India - 110005
            </p>
            <a href="https://maps.google.com" target="_blank" class="btn-gold">
                <i class="fa-solid fa-map-location-dot"></i> Open in Google Maps
            </a>
        </div>
    </section>

    <!-- RSVP & Contacts -->
    <section>
        <div class="section-header">
            <h2 class="section-title">RSVP & With Best Compliments</h2>
        </div>

        <!-- Family Hosts -->
        <div class="host-grid">
            <div class="host-card">
                <h4 class="host-title">RSVP</h4>
                <p>Sunil Kumar & Brothers</p>
                <a href="tel:+919876543210" class="contact-link"><i class="fa-solid fa-phone"></i> +91 98765 43210</a>
            </div>

            <div class="host-card">
                <h4 class="host-title">Swagat Aakankshi</h4>
                <p>All Relatives & Friends</p>
                <a href="https://wa.me/919876543210" target="_blank" class="contact-link"><i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp</a>
            </div>
        </div>

        <!-- Interactive RSVP Submission -->
        <div class="rsvp-form">
            <h3 style="text-align:center; font-family:'Playfair Display'; color:var(--primary); margin-bottom: 1.5rem;">Confirm Your Attendance</h3>
            <form id="weddingRsvp">
                <div class="form-group">
                    <label>Aapka Naam (Your Name)</label>
                    <input type="text" id="guestName" placeholder="Enter Full Name" required>
                </div>
                <div class="form-group">
                    <label>Kitne Mehmaan (No. of Guests)</label>
                    <select id="guestCount">
                        <option value="1">1 Member</option>
                        <option value="2">2 Members</option>
                        <option value="3+">Entire Family</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Aashirvaad / Warm Wishes</label>
                    <textarea id="guestMessage" rows="3" placeholder="Apna aashirvaad ya sandesh likhein..."></textarea>
                </div>
                <button type="submit" class="btn-gold" style="width: 100%; justify-content: center;">
                    <i class="fa-brands fa-whatsapp"></i> Send RSVP via WhatsApp
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-note">Hum Aapka Intezar Karenge</div>
        <p style="font-size: 0.9rem; opacity: 0.85;">We cordially invite you and your family to bless the couple.</p>
        <p style="margin-top: 15px; font-size: 0.75rem; letter-spacing: 1px; color: var(--gold-light);">Designed with ❤️ for Sameer & Priya's Wedding</p>
    </footer>

    <!-- JavaScript Functionality -->
    <script>
        // Set Wedding Date for Live Countdown (YYYY, MM-1, DD)
        const weddingDate = new Date("December 14, 2026 19:30:00").getTime();

        const timer = setInterval(() => {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            if (distance < 0) {
                clearInterval(timer);
                document.getElementById("countdown").innerHTML = "<p style='color:var(--gold); font-weight:bold;'>The Celebration Has Begun!</p>";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days").innerText = days < 10 ? '0' + days : days;
            document.getElementById("hours").innerText = hours < 10 ? '0' + hours : hours;
            document.getElementById("minutes").innerText = minutes < 10 ? '0' + minutes : minutes;
            document.getElementById("seconds").innerText = seconds < 10 ? '0' + seconds : seconds;
        }, 1000);

        // Music Player Toggle
        const musicBtn = document.getElementById('musicToggle');
        const audio = document.getElementById('weddingAudio');
        let isPlaying = false;

        musicBtn.addEventListener('click', () => {
            if (isPlaying) {
                audio.pause();
                musicBtn.innerHTML = '<i class="fa-solid fa-music"></i>';
            } else {
                audio.play().catch(err => console.log("Audio autoplay prevented"));
                musicBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
            }
            isPlaying = !isPlaying;
        });

        // WhatsApp RSVP Form Handling
        document.getElementById('weddingRsvp').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('guestName').value;
            const count = document.getElementById('guestCount').value;
            const msg = document.getElementById('guestMessage').value;

            const text = `Namaste! Main ${name} shaadi me zaroor shamil hounga/houngi. (Total guests: ${count}). Message: ${msg}`;
            const targetPhone = "919876543210"; // Yahan WhatsApp number replace karein

            window.open(`https://api.whatsapp.com/send?phone=${targetPhone}&text=${encodeURIComponent(text)}`, '_blank');
        });
    </script>
</body>
</html>
